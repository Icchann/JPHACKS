# ローカル開発用のダミー設定です。実際の秘密情報は記載しません。
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000
# 通常はdev。実証実験はscripts/run_test_environment.pyがtestを設定します。
APP_ENVIRONMENT=dev
SANMOU_APP_ENV=dev
OBSERVATION_CSV_PATH=backend/data/observations.csv
# test環境では一括起動スクリプトが検証用SQLiteのURLを自動設定します。
DATABASE_URL=sqlite+pysqlite:///backend/data/sanmou-test.sqlite3
# 手動test起動時だけ同じ値をFastAPIとNext.jsへ渡します。一括起動では自動生成します。
SANMOU_TEST_API_TOKEN=replace-with-random-test-token

